struct dnf_result { failed: bool, changed: bool }

enum dnf_state { absent, present, installed, removed, latest }

module ansible.builtin.dnf aka dnf, ansible.builtin.yum, yum -> dnf_result {
  assert env().os_family == "RedHat";

  [name aka pkg : list string]
  [state : dnf_state = dnf_state::present]
  (update_cache aka update-cache : bool = false)

  let res = dnf_result { failed: false, changed: false };

  if update_cache { e_dnf().cache_version = get_time(); res.changed = true; }

  if provided name {
    match state {
      dnf_state::absent => {
        for n in name {
          clear e_package(n);
        }
      }
      dnf_state::removed => {
        for n in name {
          clear e_package(n);
        }
      }
      dnf_state::latest => {
        for n in name {
          touch e_package(n).e_dnf();
          e_package(n).version = package_version::latest;
        }
      }
      dnf_state::present => {
        for n in name {
          touch e_package(n).e_dnf();
        }
      }
      dnf_state::installed => {
        for n in name {
          touch e_package(n).e_dnf();
        }
      }
    }
    // TODO: Only when change actually made
    res.changed = true;
  }

  return res;
}
