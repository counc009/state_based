uninterpreted count_bytes(string) -> int
uninterpreted count_words(string) -> int
uninterpreted count_lines(string) -> int

module wc -> int {
  [file : path]
  [lines: bool = false]
  [bytes: bool = false]
  [words: bool = false]

  let contents = "";
  if provided file {
    if file = '-' {
      contents = read(0);
    } else {
      if exists fs(file) {
        contents = fs(file).contents;
      } else {
        return 1;
      }
    }
  } else {
    contents = read(0);
  }

  if lines {
    write(1, string_of_int(count_lines(string)));
    write(1, " ");
  }
  if words {
    write(1, string_of_int(count_words(string)));
    write(1, " ");
  }
  if bytes {
    write(1, string_of_int(count_bytes(string)));
    write(1, " ");
  }

  if provided file {
    write(1, string_of_path(file));
  }
  write(1, "\n");

  return 0;
}
