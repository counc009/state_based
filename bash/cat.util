module cat -> int {
  (files: list path = list::<path>::nil)

  let error = false;

  if files == list::<path>::nil {
    write(1, read(0));
  } else {
    for f in files {
      if f == '-' {
        write(1, read(0));
      } else {
        if exists fs(f) {
          write(1, fs(f).contents);
        } else {
          error = true;
          // Technically write to stderr
        }
      }
    }
  }

  return error ? 1 : 0;
}
