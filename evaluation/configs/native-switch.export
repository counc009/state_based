    "astring"
    "fpath"
    "fmt" {>= "0.8.10"}
    "logs"
    "mtime" {with-test}
  ]
  build: ["ocaml" "pkg/pkg.ml" "build" "--dev-pkg" "%{dev}%"]
  dev-repo: "git+https://erratique.ch/repos/bos.git"
  url {
    src: "https://erratique.ch/software/bos/releases/bos-0.3.0.tbz"
    checksum:
